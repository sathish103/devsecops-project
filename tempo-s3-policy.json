{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TempoBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::devsecops-tempo-ap-south-1-124666675720"
    },
    {
      "Sid": "TempoObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::devsecops-tempo-ap-south-1-124666675720/*"
    }
  ]
}