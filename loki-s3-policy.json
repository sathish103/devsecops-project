
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LokiBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::devsecops-loki-ap-south-1-425034746703"
    },
    {
      "Sid": "LokiObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::devsecops-loki-ap-south-1-425034746703/*"
    }
  ]
}
